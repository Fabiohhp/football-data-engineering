# Copy this file to .env and fill in real values. .env is gitignored.

# --- PostgreSQL (data warehouse + Airflow metadata) ---
POSTGRES_USER=football
POSTGRES_PASSWORD=football
POSTGRES_DB=football_dw
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- MinIO (S3-compatible object storage for Bronze/Silver) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://minio:9000
MINIO_BRONZE_BUCKET=bronze
MINIO_SILVER_BUCKET=silver

# --- Football-Data.org API ---
# https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=changeme

# --- Airflow ---
# Metadata database. Same PostgreSQL instance as the warehouse, separate
# database and role: scheduler bookkeeping has no business sharing a namespace
# with the Gold contract. Created idempotently by the airflow-metadb service.
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow

# Login for the Airflow UI at http://localhost:8088
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

# Signs the tokens tasks use to call the Task Execution API. Any non-empty
# string works locally; change it for anything shared.
AIRFLOW_JWT_SECRET=change-me-jwt-secret

# Encrypts connection passwords at rest in the metadata DB. Optional here,
# because this stack defines its connections as AIRFLOW_CONN_* environment
# variables that never reach the database. To set one:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
